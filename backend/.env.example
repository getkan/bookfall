# Copy to .env and fill in values. .env is gitignored; never commit secrets.
# dotenv-rails loads .env automatically in development and test.
# Production-only variables are commented out: leaving them set but empty
# overrides Rails defaults (for example an empty RAILS_MASTER_KEY shadows
# config/master.key and breaks credentials).

# --- Database ---------------------------------------------------------------
# Development and test use SQLite from config/database.yml and need no URL.
# Production (Vercel + Neon): pooled connection string used by the running app.
# DATABASE_URL=
# Production: direct (unpooled) connection string used only by migrations.
# DATABASE_URL_UNPOOLED=

# --- Rails ------------------------------------------------------------------
# Decrypts config/credentials.yml.enc. Locally, config/master.key is used;
# set this only in production or when master.key is absent.
# RAILS_MASTER_KEY=
# Puma threads and Active Record pool size.
RAILS_MAX_THREADS=3
# debug, info, warn, error
RAILS_LOG_LEVEL=info
# Port Puma listens on. Vercel sets this automatically.
PORT=3001

# --- Admin (one-time rake task creates the single admin from these) --------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- CORS -------------------------------------------------------------------
# Origin of the Next.js frontend allowed to call this API.
FRONTEND_ORIGIN=http://localhost:3000

# --- Book event synchronization ----------------------------------------------
# Scheduler interval in positive whole seconds (600 = 10 minutes).
# Scheduling infrastructure is not implemented yet.
BOOK_EVENTS_SYNC_INTERVAL_SECONDS=600
